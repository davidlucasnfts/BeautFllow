# StudioFlow — Environment Variables Template
# Copiar para .env e preencher com valores reais
# NUNCA commitar .env com valores reais

# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Segredo de assinatura JWT das sessões — min 32 chars
CORS_ORIGIN=              # Origem permitida em produção (ex: https://studioflow-navy.vercel.app)

# ── Database (PostgreSQL / Supabase) ───────────────────────────
DATABASE_URL=             # PostgreSQL connection string (postgresql://user:pass@host:port/db?sslmode=require)

# ── Frontend (exposed to browser via Vite) ──────────────────────
# ATENCAO: NUNCA prefixe secrets com VITE_ — elas ficam expostas no bundle do cliente

# ── Sentry (Error Tracking) ─────────────────────────────────────
# Opcional — só em produção
SENTRY_DSN=               # Backend DSN (ex: https://xxx@yyy.ingest.sentry.io/zzz)
VITE_SENTRY_DSN=          # Frontend DSN (mesmo valor, exposto no bundle)

# ── Resend (Recuperação de senha) ───────────────────────────────
# Opcional em dev (sem chave, o link de recuperação aparece no terminal do servidor)
# Obrigatório em produção para o "Esqueci a senha" funcionar
RESEND_API_KEY=           # API key do Resend (resend.com)
RESEND_FROM=              # Remetente dos e-mails (padrão: StudioFlow <onboarding@resend.dev>)

# ── Notificações Push (VAPID) ───────────────────────────────────────────
# Opcional — sem essas chaves, notificações push ficam desativadas
# Gere um par de chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=         # Chave pública VAPID
VAPID_PRIVATE_KEY=        # Chave privada VAPID
VAPID_SUBJECT=            # Contato do remetente (ex: mailto:contato@studioflow.com.br)
